// Single source of truth for the device's web API surface.
//
// Grammar (rigid, machine-consumed - keep one entry per line):
//   ROUTE(NAME, "METHODS", "/api/path")      always registered
//   ROUTE_OPT(NAME, "METHODS", "/api/path")  registered only under a
//                                            build flag (may be absent
//                                            at runtime)
// METHODS is |-separated (GET|POST|DELETE, or WS for the websocket).
// `{}` marks a one-segment path parameter. The def models paths and
// methods; auth-gating is deliberately out of scope (enforced in the
// handlers, reviewed by hand).
//
// Consumers:
//   - src/Web/ApiRoutes.h            X-macro include -> ApiRoutes::NAME
//     constants; all C++ registration goes through these (a typo'd
//     route is a compile error, not a runtime 404).
//   - extra_script.py embed_spa()    generates the SPA's `API` table;
//     the SPA never writes /api path literals.
//   - tools/check_api_parity.py     bans raw /api literals on both
//     sides and cross-checks API.* references against this file.
//   - GET /api/diag/routes          the running device reports what it
//     actually registered; tools/kiss-test/test_api/test_routes.py
//     asserts it matches this file.

ROUTE(INFO,                     "GET",          "/api/info")
ROUTE(DIAG_MEM,                 "GET|POST",     "/api/diag/mem")
ROUTE_OPT(DIAG_LOOP,            "GET|POST",     "/api/diag/loop")
ROUTE(DIAG_TRANSPORT,           "GET",          "/api/diag/transport")
ROUTE_OPT(DIAG_HEAPTRACE,       "GET",          "/api/diag/heaptrace")
ROUTE(DIAG_ROUTES,              "GET",          "/api/diag/routes")
ROUTE(DIAG_DISPLAY,             "GET|POST",     "/api/diag/display")
ROUTE(DIAG_STORAGE,             "GET",          "/api/diag/storage")
ROUTE(AUTH_LOGIN,               "POST",         "/api/auth/login")
ROUTE(AUTH_LOGOUT,              "POST",         "/api/auth/logout")
ROUTE(IDENTITIES,               "POST",         "/api/identities")
ROUTE(IDENTITY,                 "GET|DELETE",   "/api/identity")
ROUTE(IDENTITY_DELETE,          "POST",         "/api/identity/delete")
ROUTE(IDENTITY_SETTINGS,        "POST",         "/api/identity/settings")
ROUTE(ANNOUNCE,                 "POST",         "/api/announce")
ROUTE(ANNOUNCES,                "GET",          "/api/announces")
ROUTE(SYSTEM_FACTORY_RESET,     "POST",         "/api/system/factory_reset")
ROUTE(SYSTEM_TRANSPORT,         "POST",         "/api/system/transport")
ROUTE(SYSTEM_KISS,              "POST",         "/api/system/kiss")
ROUTE(SYSTEM_REBOOT,            "POST",         "/api/system/reboot")
ROUTE(TIME,                     "GET|POST",     "/api/time")
ROUTE(TIME_SOURCES,             "POST",         "/api/time/sources")
ROUTE(GPS,                      "GET",          "/api/gps")
ROUTE(RTC,                      "GET",          "/api/rtc")
ROUTE(SENSORS_CONFIG,           "POST",         "/api/sensors/config")
ROUTE(TELEMETRY_CONFIG,         "GET|POST",     "/api/telemetry/config")
ROUTE(TELEMETRY_SEND,           "POST",         "/api/telemetry/send")
ROUTE(TELEMETRY_SHARES,         "GET",          "/api/telemetry/shares")
ROUTE(TELEMETRY_SHARES_STOP,    "POST",         "/api/telemetry/shares/stop")
ROUTE(MESSENGER_PRESETS,        "GET|POST",     "/api/messenger/presets")
ROUTE(INBOX_CONFIG,             "GET|POST",     "/api/inbox_config")
ROUTE(STORAGE_CONFIG,           "GET|POST",     "/api/storage/config")
ROUTE(STORAGE_MIGRATE,          "POST",         "/api/storage/migrate_flash_to_sd")
ROUTE(ATTACHMENT_UPLOAD,        "POST",         "/api/attachment/upload")
ROUTE(ATTACHMENT_DOWNLOAD,      "GET",          "/api/attachment/download/{}")
ROUTE(MAP_CONFIG,               "GET|POST",     "/api/map/config")
ROUTE(MAP_TILE,                 "GET",          "/api/map/tile/{}/{}/{}")
ROUTE(MAP_LAYERS,               "GET",          "/api/map/layers")
ROUTE(MAP_LAYER,                "GET|DELETE",   "/api/map/layer/{}")
ROUTE(MAP_DOWNLOAD,             "GET|POST",     "/api/map/download")
ROUTE(MAP_DOWNLOAD_CANCEL,      "POST",         "/api/map/download/cancel")
ROUTE(MAP_EXTRACT,              "GET|POST",     "/api/map/extract")
ROUTE(MAP_EXTRACT_CANCEL,       "POST",         "/api/map/extract/cancel")
ROUTE(INBOX,                    "GET",          "/api/inbox")
ROUTE(OUTBOX,                   "GET",          "/api/outbox")
ROUTE(OUTBOX_RETRY,             "POST",         "/api/outbox/{}/retry")
ROUTE(SEND,                     "POST",         "/api/send")
ROUTE(STATE,                    "GET",          "/api/state")
ROUTE(CONVERSATION,             "DELETE",       "/api/conversations/{}")
ROUTE(CONVERSATION_CONFIG,      "GET|POST",     "/api/conversations/{}/config")
ROUTE(PATHS_LOOKUP,             "POST",         "/api/paths/lookup")
ROUTE(PATHS_ESTIMATE,           "GET",          "/api/paths/estimate")
ROUTE(WIFI_SCAN,                "GET",          "/api/wifi/scan")
ROUTE(WIFI_CONFIGURE,           "POST",         "/api/wifi/configure")
ROUTE(WIFI_SOFTAP,              "POST",         "/api/wifi/softap")
ROUTE(WIFI_SAVED,               "GET",          "/api/wifi/saved")
ROUTE(WIFI_FORGET,              "POST",         "/api/wifi/forget")
ROUTE(RADIO,                    "GET|POST",     "/api/radio")
ROUTE(RADIO_TELEMETRY,          "GET",          "/api/radio/telemetry")
ROUTE(RADIO_RESET,              "POST",         "/api/radio/reset")
ROUTE(RADIO_AIRTIME,            "POST",         "/api/radio/airtime")
ROUTE(NETWORK_TELEMETRY,        "GET",          "/api/network/telemetry")
ROUTE_OPT(TCP_CLIENTS,          "GET|POST",     "/api/transport/tcp_clients")
ROUTE_OPT(TCP_CLIENT,           "DELETE",       "/api/transport/tcp_clients/{}")
ROUTE_OPT(TCP_CLIENT_PATCH,     "POST",         "/api/transport/tcp_clients/{}/patch")
ROUTE(DISCOVERY_STATE,          "GET|POST",     "/api/discovery/state")
ROUTE(DISCOVERY_IDENTITY,       "GET",          "/api/discovery/identity")
ROUTE(LORA_DISCOVERABLE,        "GET|POST",     "/api/transport/lora/discoverable")
ROUTE(LORA_CONFIG,              "GET|POST",     "/api/transport/lora/config")
ROUTE(UDP_CONFIG,               "GET|POST",     "/api/transport/udp/config")
ROUTE(WS,                       "WS",           "/api/ws")
